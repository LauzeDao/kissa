#!/usr/bin/env bash
# kissa – die Kommandozentrale deines Systems.
#   kissa                 Menü öffnen
#   kissa status          Welches Image läuft gerade?
#   kissa update          Neues Image holen (wird beim nächsten Neustart aktiv)
#   kissa rollback        Zurück zum vorherigen Image
#   kissa theme [matcha|hojicha]   Hell/Dunkel umschalten
#   kissa info            Systemübersicht (fastfetch)
#   kissa tee [text]      Der Panda sagt etwas
#   kissa lab up|down     Lokalen Kubernetes-Cluster (kind) starten/stoppen
#   kissa setup           Terminal, Prompt und Theme für deinen Benutzer einrichten
#   kissa layout          Seitenleiste + Notch wiederherstellen
#   kissa glas an|aus     Leichte Transparenz für Fenster und Menüs
set -euo pipefail

CONF="${XDG_CONFIG_HOME:-$HOME/.config}"
KISSA_SHARE="${KISSA_SHARE:-/usr/share/kissa}"
WALLPAPERS="${KISSA_WALLPAPERS:-/usr/share/backgrounds/kissa}"
THEME="$(cat "$CONF/kissa/theme" 2>/dev/null || echo matcha)"
RUST="#D06A35"; MUTED="#9893A5"
case $THEME in hojicha) ACCENT="#F0B6C1"; UME="#E07A6A";; *) ACCENT="#7A9A4F"; UME="#B4637A";; esac
has() { command -v "$1" >/dev/null 2>&1; }

# ---------- Darstellung (mit gum hübsch, ohne gum schlicht) ----------
title() {
  if has gum; then
    gum style --border rounded --border-foreground "$RUST" --foreground "$RUST" \
      --bold --padding "0 2" --margin "1 0 0 0" "喫茶 kissa · $*"
  else printf '\n== kissa · %s ==\n' "$*"; fi
}
ok()   { if has gum; then gum style --foreground "$ACCENT" "✓ $*"; else echo "✓ $*"; fi; }
warn() { if has gum; then gum style --foreground "$UME"    "✗ $*"; else echo "✗ $*" >&2; fi; }
note() { if has gum; then gum style --foreground "$MUTED" "$*"; else echo "$*"; fi; }
confirm() { if has gum; then gum confirm --selected.background "$ACCENT" "$1"; else read -rp "$1 [j/N] " a; [[ $a == [jJyY] ]]; fi; }
spin() { local t=$1; shift; if has gum; then gum spin --spinner moon --title "$t" --show-output -- "$@"; else echo "$t"; "$@"; fi; }

# ---------- Befehle ----------
cmd_status() {
  title "Status"
  if has bootc; then sudo bootc status --format humanreadable 2>/dev/null || sudo bootc status
  else warn "bootc nicht gefunden – läuft das hier wirklich auf kissa?"; fi
}

cmd_update() {
  title "Update"
  spin "Hoji schaut nach einem neuen Image …" sudo bootc upgrade
  ok "Fertig. Das neue Image ist beim nächsten Neustart aktiv."
  note "Gefällt es dir nicht? → kissa rollback"
}

cmd_rollback() {
  title "Rollback"
  note "Beim nächsten Neustart startet wieder das vorherige Image."
  if confirm "Wirklich zurückrollen?"; then sudo bootc rollback && ok "Rollback vorgemerkt. Bitte neu starten."
  else note "Abgebrochen."; fi
}

cmd_theme() {
  local t="${1:-}"
  if [[ -z $t ]]; then
    if has gum; then t=$(gum choose --header "Welche Teesorte?" --cursor.foreground "$RUST" matcha hojicha)
    else read -rp "matcha oder hojicha? " t; fi
  fi
  case $t in matcha|hojicha) ;; *) warn "Unbekanntes Theme: $t (matcha oder hojicha)"; return 1;; esac
  title "Theme → $t"
  # Global Theme: Farben, Mauszeiger, Fensterrahmen, Ladebildschirm (Layout nur mit --layout)
  local laf_args=(-a "org.kissa.$t")
  [[ ${2:-} == --layout ]] && laf_args+=(--resetLayout)
  if has plasma-apply-lookandfeel && plasma-apply-lookandfeel "${laf_args[@]}" >/dev/null 2>&1; then
    ok "Desktop-Theme (Farben, Mauszeiger, Ladebildschirm)"
    [[ ${2:-} == --layout ]] && ok "Seitenleiste + Notch"
  elif has plasma-apply-colorscheme && plasma-apply-colorscheme "Kissa${t^}" >/dev/null 2>&1; then
    ok "Desktop-Farben"; warn "Global Theme org.kissa.$t nicht angewendet, nur die Farben"
  else
    warn "Desktop-Theme nicht gesetzt (läuft Plasma?)"
  fi
  local img="$WALLPAPERS/contents/images/3840x2160.png"
  [[ $t == hojicha ]] && img="$WALLPAPERS/contents/images_dark/3840x2160.png"
  if [[ -f $img ]] && has plasma-apply-wallpaperimage; then
    if plasma-apply-wallpaperimage "$img" >/dev/null 2>&1; then ok "Hintergrundbild"; else warn "Hintergrundbild nicht gesetzt (läuft Plasma?)"; fi
  fi
  mkdir -p "$CONF/kissa" && echo "$t" > "$CONF/kissa/theme"
  ln -sf "$KISSA_SHARE/hoji-$t.ansi" "$CONF/kissa/hoji.ansi" && ok "Hoji im Terminal"
  local key; [[ $t == hojicha ]] && key="38;2;240;182;193" || key="38;2;122;154;79"
  [[ -f $CONF/fastfetch/config.jsonc ]] && sed -i "s/\"keys\": \"[^\"]*\"/\"keys\": \"$key\"/" "$CONF/fastfetch/config.jsonc" && ok "fastfetch"
  [[ -f $CONF/starship.toml ]] && sed -i "s/^palette = .*/palette = \"$t\"/" "$CONF/starship.toml" && ok "Prompt"
  if has kwriteconfig6; then
    kwriteconfig6 --file konsolerc --group "Desktop Entry" --key DefaultProfile "kissa-$t.profile" && ok "Terminal-Profil"
  fi
  if [[ -n ${KONSOLE_VERSION:-} ]] && has konsoleprofile; then konsoleprofile "ColorScheme=kissa-$t"; fi
  note "Neue Terminals übernehmen das Theme automatisch."
}

cmd_lab() {
  local action="${1:-up}" name="kissa-lab"
  has kind || { warn "kind ist nicht installiert."; return 1; }
  export KIND_EXPERIMENTAL_PROVIDER=podman
  case $action in
    up)   title "K8s-Lab starten"
          spin "Cluster wird gebaut (dauert ca. 1 Minute) …" kind create cluster --name "$name"
          ok "Cluster läuft. Probier: kubectl get nodes  oder  k9s";;
    down) title "K8s-Lab stoppen"
          confirm "Cluster $name löschen?" && kind delete cluster --name "$name" && ok "Weg ist er.";;
    *)    warn "kissa lab up | down";;
  esac
}

cmd_setup() {
  # --once: nur beim allerersten Login (Autostart), danach nie wieder automatisch
  if [[ ${1:-} == --once ]]; then
    [[ -f $CONF/kissa/setup-done ]] && return 0
    mkdir -p "$CONF/kissa" "${XDG_CACHE_HOME:-$HOME/.cache}"
    exec >>"${XDG_CACHE_HOME:-$HOME/.cache}/kissa-setup.log" 2>&1
    echo "--- $(date) kissa setup --once"
    # Warten, bis der Plasma-Desktop läuft – sonst greifen Wallpaper und Farben ins Leere
    for _ in $(seq 1 60); do pgrep -u "$USER" -x plasmashell >/dev/null && break; sleep 1; done
    sleep 5
  fi
  title "Einrichtung"
  mkdir -p "$CONF/fastfetch" "$CONF/kissa"
  if [[ ! -f $CONF/fastfetch/config.jsonc ]]; then cp "$KISSA_SHARE/skel/fastfetch/config.jsonc" "$CONF/fastfetch/" && ok "fastfetch"; fi
  if [[ ! -f $CONF/starship.toml ]]; then cp "$KISSA_SHARE/skel/starship.toml" "$CONF/" && ok "Prompt"; fi
  if ! grep -q "bashrc-kissa.sh" "$HOME/.bashrc" 2>/dev/null; then
    printf '\n# kissa: Prompt, Begrüßung, Aliase\n[ -f %s/bashrc-kissa.sh ] && source %s/bashrc-kissa.sh\n' \
      "$KISSA_SHARE" "$KISSA_SHARE" >> "$HOME/.bashrc"
    ok "bash"
  fi
  if has kwriteconfig6; then
    kwriteconfig6 --file kdeglobals --group General --key TerminalApplication konsole
    kwriteconfig6 --file kdeglobals --group General --key TerminalService org.kde.konsole.desktop
    ok "Konsole als Standard-Terminal"
  fi
  cmd_glass an
  local t; t="$(cat "$CONF/kissa/theme" 2>/dev/null || echo matcha)"
  cmd_theme "$t" --layout
  touch "$CONF/kissa/setup-done"
}

# Leichte Transparenz für Fenster und Menüs (KWin), Blur dahinter
cmd_glass() {
  local mode="${1:-an}" r=kwinrulesrc g=kissa-transparenz rules
  has kwriteconfig6 || { warn "kwriteconfig6 fehlt"; return 1; }
  rules=$(kreadconfig6 --file "$r" --group General --key rules 2>/dev/null || true)
  case $mode in
    an)
      kwriteconfig6 --file kwinrc --group Plugins --key translucencyEnabled true
      kwriteconfig6 --file kwinrc --group Plugins --key blurEnabled true
      for key in Menus DropdownMenus PopupMenus ComboboxPopups TornOffMenus; do
        kwriteconfig6 --file kwinrc --group Effect-translucency --key "$key" 90
      done
      kwriteconfig6 --file kwinrc --group Effect-translucency --key Dialogs 95
      kwriteconfig6 --file kwinrc --group Effect-translucency --key MoveResize 85
      # Fensterregel für normale Fenster (1) und Dialoge (32): aktiv 96 %, inaktiv 88 %
      kwriteconfig6 --file "$r" --group "$g" --key Description "kissa: leichte Transparenz"
      kwriteconfig6 --file "$r" --group "$g" --key types 33
      kwriteconfig6 --file "$r" --group "$g" --key opacityactive 96
      kwriteconfig6 --file "$r" --group "$g" --key opacityactiverule 2
      kwriteconfig6 --file "$r" --group "$g" --key opacityinactive 88
      kwriteconfig6 --file "$r" --group "$g" --key opacityinactiverule 2
      if [[ ",$rules," != *",$g,"* ]]; then rules="${rules:+$rules,}$g"; fi
      ;;
    aus)
      kwriteconfig6 --file kwinrc --group Plugins --key translucencyEnabled false
      rules=$(tr ',' '\n' <<<"$rules" | grep -vx "$g" | paste -sd, - || true)
      ;;
    *) warn "kissa glas an | aus"; return 1;;
  esac
  kwriteconfig6 --file "$r" --group General --key rules "$rules"
  kwriteconfig6 --file "$r" --group General --key count "$(tr ',' '\n' <<<"$rules" | grep -c . || true)"
  dbus-send --session --dest=org.kde.KWin --type=method_call /KWin org.kde.KWin.reconfigure 2>/dev/null || true
  ok "Transparenz $mode"
}

cmd_menu() {
  has gum || { sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; return; }
  pandasay "Was möchtest du tun?" 2>/dev/null || title "Menü"
  local c
  c=$(gum choose --cursor.foreground "$RUST" --selected.foreground "$ACCENT" \
      "🍵 Status" "⬆️  Update" "↩️  Rollback" "🎨 Theme" "🪟 Transparenz an/aus" "🐾 Systeminfo" "⎈  K8s-Lab starten" "🧹 K8s-Lab stoppen" "Beenden") || return 0
  case $c in
    *Status*) cmd_status;; *Update*) cmd_update;; *Rollback*) cmd_rollback;;
    *Theme*) cmd_theme;;
    *Transparenz*) if gum confirm "Transparenz einschalten?"; then cmd_glass an; else cmd_glass aus; fi;; *Systeminfo*) fastfetch;;
    *starten*) cmd_lab up;; *stoppen*) cmd_lab down;;
  esac
}

case "${1:-}" in
  "")          cmd_menu;;
  status)      cmd_status;;
  update)      cmd_update;;
  rollback)    cmd_rollback;;
  theme)       shift; cmd_theme "${1:-}";;
  info)        fastfetch;;
  tee)         shift; pandasay "$@";;
  lab)         shift; cmd_lab "${1:-up}";;
  setup)       shift; cmd_setup "${1:-}";;
  layout)      cmd_theme "$THEME" --layout;;
  glas)        shift; cmd_glass "${1:-an}";;
  -h|--help|help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//';;
  *)           warn "Unbekannter Befehl: $1"; sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 1;;
esac
