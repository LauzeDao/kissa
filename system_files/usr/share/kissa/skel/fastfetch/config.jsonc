// kissa – fastfetch-Konfiguration
// Ziel: ~/.config/fastfetch/config.jsonc   Logo: ~/.config/kissa/hoji.ansi (setzt "kissa theme")
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // Pixel-Hoji (Truecolor-ANSI). "kissa theme" verlinkt hier die passende Variante.
    "type": "file-raw",
    "source": "~/.config/kissa/hoji.ansi",
    "width": 24,
    "height": 10,
    "padding": { "top": 2, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;122;154;79", "title": "38;2;208;106;53" },
    "key": { "width": 11 }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "custom", "format": "\u001b[38;2;152;147;165m喫茶 kissa · お茶をどうぞ\u001b[0m" },
    "break",
    { "type": "os",       "key": "os" },
    { "type": "kernel",   "key": "kernel" },
    { "type": "uptime",   "key": "uptime" },
    { "type": "packages", "key": "pakete" },
    { "type": "de",       "key": "desktop" },
    { "type": "shell",    "key": "shell" },
    { "type": "terminal", "key": "terminal" },
    "break",
    { "type": "cpu",      "key": "cpu" },
    { "type": "memory",   "key": "ram" },
    { "type": "disk",     "key": "disk", "folders": "/" },
    { "type": "battery",  "key": "akku" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
